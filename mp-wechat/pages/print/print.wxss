.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef2ff 0%, #f4f6fb 30%, #f4f6fb 100%);
}

/* ---------- 顶部区域设置 ---------- */
.bar {
  flex: none;
  padding: 20rpx 24rpx 12rpx;
}

.bar-row {
  display: flex;
  align-items: center;
}

.chips {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.chip {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e2e8f5;
  font-size: 24rpx;
  color: #4a5568;
}

.tip {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #98a1b4;
}

.lbl {
  font-size: 24rpx;
  color: #66707f;
}

.num {
  width: 130rpx;
  height: 60rpx;
  margin: 0 12rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f5;
  background: #fff;
  font-size: 26rpx;
  text-align: center;
  color: #1f2430;
}

.num.sm {
  width: 110rpx;
  height: 56rpx;
  margin: 0 0 0 8rpx;
}

/* ---------- 纸面 ---------- */
.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  overflow: hidden;
}

.frame {
  position: relative;
  border: 2rpx dashed #b7c2da;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(55, 65, 120, 0.08);
  overflow: hidden;
}

.item {
  position: absolute;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.item.on {
  border-color: #2f6bff;
}

.img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 四角圆点：命中区比视觉大，方便手指按 */
.hd {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
}

.hd::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #2f6bff;
  border: 2rpx solid #fff;
  box-shadow: 0 0 0 1rpx rgba(47, 107, 255, 0.35);
}

.hd.tl { left: -22rpx; top: -22rpx; }
.hd.tr { right: -22rpx; top: -22rpx; }
.hd.bl { left: -22rpx; bottom: -22rpx; }
.hd.br { right: -22rpx; bottom: -22rpx; }

.empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 26rpx;
  color: #9aa3b6;
  line-height: 1.8;
}

/* ---------- 检查器 ---------- */
.card {
  flex: none;
  margin: 0 24rpx 12rpx;
  padding: 18rpx 20rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(55, 65, 120, 0.08);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field {
  display: flex;
  align-items: center;
}

.row2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.pad {
  display: grid;
  grid-template-columns: repeat(3, 72rpx);
  grid-auto-rows: 52rpx;
  gap: 8rpx;
  margin-right: 30rpx;
}

.nd {
  width: 72rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2f6bff;
  background: #f2f6ff;
  border-radius: 10rpx;
}

.nd.up { grid-column: 2; grid-row: 1; }
.nd.left { grid-column: 1; grid-row: 2; }
.nd.mid { grid-column: 2; grid-row: 2; }
.nd.right { grid-column: 3; grid-row: 2; }
.nd.down { grid-column: 2; grid-row: 3; }

.nd.mid {
  color: #9aa3b6;
  background: #f7f9fc;
  font-size: 22rpx;
}

.side {
  display: flex;
  align-items: center;
}

.lock {
  display: flex;
  align-items: center;
  margin-right: 18rpx;
}

.lock switch {
  transform: scale(0.8);
}

.del {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #d0454f;
  background: #fff2f3;
}

/* ---------- 底部操作 ---------- */
.panel {
  flex: none;
  display: flex;
  padding: 12rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(55, 65, 120, 0.06);
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  margin-right: 16rpx;
  padding: 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #3d4a61;
  background: #f4f6fb;
  border: 1rpx solid #e2e8f5;
}

.btn:last-child {
  margin-right: 0;
}

.btn.primary {
  color: #fff;
  background: #2f6bff;
  border-color: #2f6bff;
  font-weight: 600;
}

.btn[disabled] {
  opacity: 0.6;
}

.offscreen {
  position: fixed;
  left: -3000px;
  top: 0;
  width: 200px;
  height: 200px;
}
