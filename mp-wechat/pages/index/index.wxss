.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 27, 45, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.date-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.hint {
  color: #79839d;
  font-size: 24rpx;
}

.row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.input {
  height: 72rpx;
  border: 1px solid #d8dbe8;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #fff;
  display: flex;
  align-items: center;
}

.btn {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #fff;
  background: #ff5f67;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn.ghost {
  color: #ff5f67;
  background: #ffeef0;
}

.user-select {
  position: relative;
}

.user-select-btn {
  justify-content: space-between;
}

.user-menu {
  position: absolute;
  z-index: 20;
  left: 0;
  right: 0;
  top: calc(100% + 8rpx);
  background: #fff;
  border: 1px solid #d8dbe8;
  border-radius: 16rpx;
  padding: 12rpx;
  box-shadow: 0 12rpx 20rpx rgba(22, 27, 45, 0.14);
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.menu-item {
  flex: 1;
  background: #f6f8fd;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
}

.menu-add {
  background: #ffeef0;
  color: #ff5f67;
  border-radius: 12rpx;
  text-align: center;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
}

.close-mini {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #eff2fa;
  color: #8d96af;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.month-label {
  font-size: 30rpx;
  font-weight: 600;
}

.month-btn {
  background: #f2f4fb;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 26rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  color: #8690a9;
  font-size: 24rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 12rpx;
  row-gap: 12rpx;
}

.day-wrap {
  display: flex;
  justify-content: center;
}

.day-wrap.empty {
  opacity: 0;
}

.day-ring {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #d8dbe8;
  padding: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-inner {
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.day-wrap.selected .day-ring {
  box-shadow: 0 0 0 2px #ff5f67;
}

.day-wrap.selected .day-inner {
  font-weight: 700;
}

.project-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.project-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.project-item {
  border: 1px solid #d8dbe8;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}

.project-item.done {
  border-color: #ff5f67;
  color: #ff5f67;
  background: #fff1f2;
}

.project-add {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  border: 1px dashed #ff5f67;
  color: #ff5f67;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.summary-list {
  margin-top: 12rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7f9ff;
  border-radius: 14rpx;
  border: 1px solid transparent;
  padding: 16rpx;
  margin-bottom: 8rpx;
  font-size: 28rpx;
}

.summary-row.active {
  border-color: #ff5f67;
  background: #fff3f4;
}

.monthly-panel {
  margin: 8rpx 0 12rpx;
  background: #f8faff;
  border-radius: 14rpx;
  padding: 14rpx;
}

.monthly-list {
  margin-top: 8rpx;
}

.monthly-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 10rpx;
  padding: 12rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.modal-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}
