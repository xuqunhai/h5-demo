.home {
  position: relative;
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.home-bg {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 45vh;
  background: linear-gradient(180deg, #e8ecff 0%, #f4f6fb 55%, transparent 100%);
  pointer-events: none;
  z-index: 0;
}

.home-header {
  position: relative;
  z-index: 1;
  margin-bottom: 36rpx;
  padding: 8rpx 4rpx 0;
}

.home-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d3348;
  letter-spacing: 1rpx;
}

.home-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8b93a8;
  line-height: 1.5;
}

.grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.cell {
  border-radius: 24rpx;
  padding: 28rpx 16rpx 24rpx;
  min-height: 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 2rpx solid #e8ecf5;
  background: linear-gradient(165deg, #ffffff 0%, #fafbff 100%);
  box-shadow: 0 10rpx 28rpx rgba(55, 65, 120, 0.06);
}

.cell--active {
  border-color: rgba(255, 107, 122, 0.45);
  background: linear-gradient(155deg, #fff8f9 0%, #ffffff 50%, #f5f7ff 100%);
  box-shadow: 0 14rpx 36rpx rgba(255, 107, 122, 0.12), 0 4rpx 12rpx rgba(55, 65, 120, 0.05);
}

.cell--placeholder {
  opacity: 0.92;
  border-style: dashed;
  border-color: #dce1ef;
  background: linear-gradient(165deg, #fcfcff 0%, #f6f8fc 100%);
}

.cell-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  background: #eef1f8;
}

.cell--active .cell-icon-wrap {
  background: linear-gradient(135deg, #ff6b7a 0%, #ff8a6b 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 122, 0.35);
}

.cell-icon {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.cell-icon--check {
  color: #fff;
  font-size: 32rpx;
}

.cell-icon--dot {
  color: #b4bccf;
  font-size: 32rpx;
  font-weight: 300;
}

.cell-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3348;
  line-height: 1.3;
}

.cell--placeholder .cell-title {
  color: #a0a8bc;
  font-weight: 500;
}

.cell-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b93a8;
  line-height: 1.35;
}

.cell--placeholder .cell-sub {
  color: #b4bccf;
}

.cell-cta {
  margin-top: auto;
  padding-top: 12rpx;
  font-size: 22rpx;
  color: #ff6b7a;
  font-weight: 600;
}
