<view class="home">
  <view class="home-bg"></view>
  <view class="home-header">
    <view class="home-title">功能中心</view>
    <view class="home-desc">选择一个功能进入，更多能力陆续开放</view>
  </view>
  <view class="grid">
    <view
      wx:for="{{slots}}"
      wx:key="key"
      class="cell {{item.filled ? 'cell--active' : 'cell--placeholder'}}"
      data-index="{{index}}"
      bindtap="onSlotTap"
    >
      <view class="cell-icon-wrap">
        <text wx:if="{{item.filled}}" class="cell-icon cell-icon--check">✓</text>
        <text wx:else class="cell-icon cell-icon--dot">+</text>
      </view>
      <view class="cell-title">{{item.title}}</view>
      <view class="cell-sub">{{item.sub}}</view>
      <view wx:if="{{item.filled}}" class="cell-cta">点击进入</view>
    </view>
  </view>
</view>
