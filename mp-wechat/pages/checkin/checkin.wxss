.page {
  position: relative;
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef2ff 0%, #f4f6fb 32%, #f4f6fb 100%);
}

.hero-glow {
  position: fixed;
  top: -120rpx;
  right: -80rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 122, 0.22) 0%, rgba(120, 140, 255, 0.08) 45%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.card {
  position: relative;
  z-index: 1;
  background: linear-gradient(165deg, #ffffff 0%, #fafbff 100%);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(55, 65, 120, 0.08), 0 2rpx 8rpx rgba(55, 65, 120, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.card-hero {
  position: relative;
  z-index: 20;
  padding-top: 28rpx;
  padding-bottom: 26rpx;
  background: linear-gradient(155deg, #ffffff 0%, #fff8f9 55%, #f5f7ff 100%);
}

.card-calendar,
.card-tasks,
.card-summary {
  position: relative;
  z-index: 1;
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.title-user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-badge {
  font-size: 22rpx;
  color: #ff6b7a;
  background: linear-gradient(90deg, rgba(255, 107, 122, 0.15), rgba(120, 140, 255, 0.12));
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-sub {
  font-size: 22rpx;
  color: #8b93a8;
}

.title {
  flex-shrink: 0;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 0;
  letter-spacing: 1rpx;
  color: #2d3348;
  line-height: 1.2;
}

.user-select {
  position: relative;
  flex: 1;
  min-width: 0;
}

.user-select-btn {
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  justify-content: space-between;
  border: 2rpx solid #e8ecf5;
  background: #fff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  padding: 0 16rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.user-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 600;
  color: #2d3348;
}

.chevron {
  flex-shrink: 0;
  margin-left: 8rpx;
  color: #a0a8bc;
  font-size: 24rpx;
}

.user-menu {
  position: absolute;
  z-index: 100;
  left: 0;
  right: 0;
  min-width: 280rpx;
  top: calc(100% + 12rpx);
  background: #fff;
  border: 1rpx solid #e8ecf5;
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: 0 20rpx 48rpx rgba(45, 51, 72, 0.12);
}

.menu-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  border: 1rpx solid #e8ecf5;
  border-radius: 14rpx;
  overflow: hidden;
  background: #fff;
}

.menu-item {
  flex: 1;
  background: linear-gradient(180deg, #f7f9ff 0%, #f0f3fb 100%);
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  color: #2d3348;
}

.menu-row .close-mini {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #d85a6d;
  flex-shrink: 0;
  margin-right: 6rpx;
}

.menu-add {
  background: linear-gradient(90deg, #fff0f2, #ffeef5);
  color: #ff6b7a;
  border-radius: 14rpx;
  text-align: center;
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.close-mini {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #8d96af;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.section-label {
  font-size: 22rpx;
  color: #8b93a8;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.date-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d3348;
  margin-bottom: 10rpx;
}

.hint {
  color: #8b93a8;
  font-size: 24rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.input {
  height: 80rpx;
  border: 2rpx solid #e8ecf5;
  border-radius: 18rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  background: #fff;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff6b7a 0%, #ff8a6b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 122, 0.35);
}

.btn.ghost {
  color: #ff6b7a;
  background: #fff0f2;
  box-shadow: none;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.month-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d3348;
}

.month-btn {
  background: linear-gradient(180deg, #f5f7ff 0%, #eef1fb 100%);
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  font-size: 26rpx;
  color: #5a6278;
  font-weight: 500;
  border: 1rpx solid #e4e8f5;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  color: #a0a8bc;
  font-size: 24rpx;
  font-weight: 500;
  padding-bottom: 8rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 8rpx;
  row-gap: 16rpx;
}

.day-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
}

.day-wrap.empty {
  opacity: 0;
}

.day-ring {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #fff0f2;
  padding: 5rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.day-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #4a5166;
  font-weight: 500;
  transition: background-color 0.15s ease, color 0.15s ease;
}

.day-wrap.selected .day-ring {
  box-shadow: none;
  transform: none;
}

.day-wrap.selected .day-inner {
  font-weight: 700;
  color: #d63d52;
  background: #fff0f2;
}

.project-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.project-chip {
  display: flex;
  align-items: stretch;
  border-radius: 999rpx;
  overflow: hidden;
  border: 2rpx solid #e4e8f5;
  background: #fff;
}

.project-item {
  border: 0;
  border-radius: 0;
  padding: 10rpx 18rpx 10rpx 14rpx;
  font-size: 26rpx;
  color: #4a5166;
  background: transparent;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tick-wrap {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff6b7a 0%, #ff8a6b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.project-item .tick {
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

.project-label {
  font-size: 26rpx;
  color: inherit;
}

.project-item.done {
  border: 0;
  color: #b83245;
  background: #fff0f2;
  box-shadow: none;
}

.project-item.done .project-label {
  font-weight: 700;
  color: #c43d4d;
}

.project-chip.done-chip {
  border-color: #ff6b7a;
}

.project-chip .close-mini {
  width: 56rpx;
  height: 100%;
  min-height: 56rpx;
  border-radius: 0;
  background: transparent;
  color: #d85a6d;
  flex-shrink: 0;
  border-left: 1rpx solid #f1f3fa;
}

.project-add {
  width: 62rpx;
  height: 62rpx;
  border-radius: 999rpx;
  border: 2rpx dashed rgba(255, 107, 122, 0.55);
  color: #ff6b7a;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
  line-height: 0;
  background: rgba(255, 107, 122, 0.06);
  box-sizing: border-box;
}

.project-add-icon {
  display: block;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 44rpx;
  height: 44rpx;
  text-align: center;
  transform: translateY(-4rpx);
}

.summary-list {
  margin-top: 16rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, #f8faff 0%, #f3f6fd 100%);
  border-radius: 18rpx;
  border: 2rpx solid transparent;
  padding: 20rpx 22rpx;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.summary-name {
  font-weight: 600;
  color: #2d3348;
}

.summary-count {
  color: #ff6b7a;
  font-weight: 700;
  font-size: 26rpx;
}

.summary-row.active {
  border-color: rgba(255, 107, 122, 0.45);
  background: linear-gradient(180deg, #fff8f9 0%, #fff0f2 100%);
}

.monthly-panel {
  margin: 6rpx 0 14rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #eef1f8;
}

.monthly-list {
  margin-top: 10rpx;
}

.monthly-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7f9ff;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #4a5166;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(25, 30, 45, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  z-index: 100;
}

.modal-card {
  width: 100%;
  max-width: 640rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fafbff 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(45, 51, 72, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}
